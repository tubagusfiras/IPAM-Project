{
  "title": "IPAM SDI - API Overview",
  "uid": "ipam-overview",
  "version": 2,
  "timezone": "browser",
  "schemaVersion": 30,
  "panels": [
    {
      "id": 1,
      "title": "API Requests",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "rate(ipam_requests_total[1m])", "legendFormat": "{{status}} {{method}} {{endpoint}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "showPoints": "never", "lineInterpolation": "smooth" } } },
      "options": { "legend": { "showLegend": false } }
    },
    {
      "id": 6,
      "title": "Request Rate (Last Hour)",
      "type": "timeseries",
      "gridPos": { "h": 14, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "rate(ipam_requests_total[1m])", "legendFormat": "Total" },
        { "expr": "rate(ipam_requests_total{status=~'2..'}[1m])", "legendFormat": "2xx" },
        { "expr": "rate(ipam_requests_total{status=~'4..'}[1m])", "legendFormat": "4xx" },
        { "expr": "rate(ipam_requests_total{status=~'5..'}[1m])", "legendFormat": "5xx" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "showPoints": "never", "lineInterpolation": "smooth" },
          "min": 0
        }
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 7,
      "title": "Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 6 },
      "targets": [{ "expr": "process_resident_memory_bytes", "legendFormat": "RSS" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "showPoints": "never", "lineInterpolation": "smooth" } } },
      "options": { "legend": { "showLegend": false } }
    },
    {
      "id": 8,
      "title": "CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 13 },
      "targets": [{ "expr": "rate(process_cpu_seconds_total[1m])", "legendFormat": "CPU" }],
      "fieldConfig": { "defaults": { "unit": "cps", "custom": { "showPoints": "never", "lineInterpolation": "smooth" } } },
      "options": { "legend": { "showLegend": false } }
    }
  ],
  "tags": ["ipam", "sdi"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s"
}
