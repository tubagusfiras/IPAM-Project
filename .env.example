# Database Configuration
POSTGRES_DB=ipam
POSTGRES_USER=ipam
POSTGRES_PASSWORD=change-me-strong-password-here

# Database URL (update with your credentials)
DATABASE_URL=postgresql://ipam:change-me-strong-password-here@db:5432/ipam

# Redis
REDIS_URL=redis://redis:6379/0

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=generate-a-strong-random-secret-here

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:8100,http://localhost:3000
